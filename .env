POSTGRES_URL_NON_POOLING="postgresql://postgres:711882GRiffo@db.viqtmnhiejoacyevfjhy.supabase.co:5432/postgres"

# Segredo da sessão (gere um forte com: openssl rand -hex 32)
# NUNCA use o valor default em produção!
SESSION_SECRET="3a6ba3c1e90c8642342798d4f6ebdd2ae3073f358fe7f065210271b5e73a4624"

# Credenciais da Z.ai (para o z-ai-web-dev-sdk)
