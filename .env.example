# Variáveis de ambiente para o Griffo
# Copie este arquivo para .env e preencha os valores

# ========================
# BANCO DE DADOS (Obrigatório)
# ========================
# URL de conexão com pool (PgBouncer)
POSTGRES_PRISMA_URL="postgresql://user:password@host:6543/database?pgbouncer=true"
# URL de conexão direta (para migrações)
POSTGRES_URL_NON_POOLING="postgresql://user:password@host:5432/database"

# ========================
# SESSÃO (Obrigatório)
# ========================
# Segredo da sessão (gere um forte com: openssl rand -hex 32)
#
# OBRIGATÓRIA. Sem ela o login e o cadastro respondem 503 — não há mais valor
# embutido no código, porque um segredo previsível permite forjar o cookie de
# qualquer usuário, inclusive o do administrador, sem saber a senha.
#
# Trocar este valor invalida todas as sessões ativas.
SESSION_SECRET=""

# ========================
# CRIPTOGRAFIA EM REPOUSO (Obrigatório para o painel administrativo)
# ========================
# Cifra os segredos guardados no banco: AiApiKey.apiKey e os valores sensíveis
# de SystemConfig (chave da Stripe, webhook secret, chaves das IAs).
# 32 bytes em hex — gere com: openssl rand -hex 32
#
# Se ausente: a leitura continua funcionando (segredos já gravados em texto
# puro passam intactos), mas GRAVAR uma chave nova pelo painel falha com uma
# mensagem explícita. Trocar este valor depois torna ilegível tudo o que já
# foi cifrado — guarde-o junto com os demais segredos de produção.
ENCRYPTION_KEY=""

# ========================
# STRIPE (Obrigatório para pagamentos)
# ========================
STRIPE_SECRET_KEY="sk_live_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Oferece Pix no checkout brasileiro. Só ligue depois de ativá-lo em
# dashboard.stripe.com > Settings > Payment methods — ele exige conta Stripe
# registrada no Brasil. Ligado sem estar ativo, a Stripe recusa a sessão e o
# checkout se recupera repetindo só com cartão, ao custo de uma chamada perdida
# por compra.
STRIPE_PIX_ENABLED="false"

# ========================
# PROVEDORES DE IA (pelo menos um obrigatório)
# ========================
# Moonshot AI (Kimi K3)
MOONSHOT_API_KEY=""
# Anthropic (Claude)
ANTHROPIC_API_KEY=""
# DeepSeek
DEEPSEEK_API_KEY=""
# Google Gemini
GEMINI_API_KEY=""

# ========================
# APLICAÇÃO
# ========================
NEXT_PUBLIC_APP_URL="https://griffo.work"

# ========================
# RADAR (§28)
# ========================
# Segredo do cron. A Vercel manda `Authorization: Bearer <valor>` sozinha nos
# crons declarados em vercel.json quando esta variável existe. SEM ELA a rota
# /api/cron/radar responde 503 e não roda — de propósito: uma rota que dispara
# coleta e escreve no banco não pode ficar aberta por esquecimento.
# Gere com: openssl rand -hex 32
CRON_SECRET=""

# Boards do Greenhouse a varrer, no formato `token:Nome,outro:Outro Nome`.
# Vazio = os boards já conferidos contra a API (ver lib/jobs/adapters/greenhouse.ts).
# Confira um board novo ANTES de acrescentá-lo:
#   curl -o /dev/null -w "%{http_code}\n" \
#     "https://boards-api.greenhouse.io/v1/boards/<token>/jobs?content=true"
GREENHOUSE_BOARDS=""

# Boards do Lever a varrer, no formato `token:Nome,outro:Outro Nome`.
# Vazio = nenhuma fonte do Lever roda (o único board conferido é o de
# demonstração, que não serve para produção).
# Confira um board novo ANTES de acrescentá-lo:
#   curl -o /dev/null -w "%{http_code}\n" \
#     "https://api.lever.co/v0/postings/<token>?mode=json"
LEVER_BOARDS=""
