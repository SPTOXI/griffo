# Variáveis de ambiente para o CareerLens
# Copie este arquivo para .env e preencha os valores

# Banco de dados SQLite (padrão local)
# Para produção, troque por Postgres:
# DATABASE_URL="postgresql://user:pass@host:5432/careerlens"
DATABASE_URL="file:./db/custom.db"

# Segredo da sessão (gere um forte com: openssl rand -hex 32)
# NUNCA use o valor default em produção!
SESSION_SECRET="career-analyst-dev-secret-change-me-in-production"

# Credenciais da Z.ai (para o z-ai-web-dev-sdk)
# São lidas automaticamente pelo SDK se definidas no ambiente
# ZAI_API_KEY="sua-chave-aqui"

# Opcional: taxa de câmbio BRL/USD para cálculo de preço (default: 5.4)
# BRL_USD_RATE="5.4"
