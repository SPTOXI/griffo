// Prisma schema - Career Analyst Platform
// PostgreSQL - via Supabase for users, resumes, analyses, subscriptions

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  phone        String?
  profession   String?
  // Role & Permissions
  role         String   @default("user") // user | admin
  disabled     Boolean  @default(false) // Account status: false = active, true = disabled
  // Plan / Credit Balance (Phase 1 Monetização por Créditos)
  credits      Int      @default(0)      // 0 credits on signup (free user must acquire Plano de Entrada)
  plan         String   @default("free") // free | day | monthly | annual
  planStartsAt DateTime?
  planEndsAt   DateTime?
  // For Phase 2: B2B recruiter marketplace consent
  recruiterOptIn Boolean @default(false)
  // Profile visibility for future recruiter search (Phase 2)
  profileVisible Boolean @default(false)
  // Audit
  createdAt    DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  resumes            Resume[]
  subscriptions      Subscription[]
  auditLogs          AuditLog[]
  aiLogs             AiLog[]
  creditTransactions CreditTransaction[]
}

model SystemConfig {
  id        String   @id @default("global")
  key       String   @unique
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

model AiApiKey {
  id        String   @id @default(cuid())
  name      String   // Name/Label (e.g., "Kimi K3 Produção")
  provider  String   // moonshot | anthropic | deepseek | gemini
  apiKey    String   // Secret API key
  baseUrl   String?  // Custom base URL if needed
  model     String   // Target AI model string
  status    String   @default("active") // active | paused
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Resume {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Original uploaded content (plain text / markdown)
  originalContent  String
  originalFormat   String   @default("text") // text | markdown
  // Analysis output as JSON (scores + strengths + weaknesses + recommendations)
  analysisJson     String?
  // Rewritten resume content (markdown)
  rewrittenContent String?
  // ATS target check results
  atsScore         Int?
  // Target job title / industry if provided
  targetJob        String?
  // Social links submitted with resume (JSON stringified record)
  socialLinksJson  String?
  // User consent for social links evaluation
  socialConsent    Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  auditLogs AuditLog[]
}

model Subscription {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan       String   // day | monthly | annual
  priceBrl   Float
  startsAt   DateTime @default(now())
  endsAt     DateTime
  status     String   @default("active") // active | cancelled | expired
  paymentRef String?  // gateway ref

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model CreditTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int      // positive for purchase/grant, negative for deduction
  type        String   // welcome | purchase | consume | admin_grant
  description String
  costBrl     Float?
  paymentRef  String?  // Lemon Squeezy Order ID or Subscription ID
  status      String   @default("completed") // pending | completed | failed

  createdAt DateTime @default(now())
}

model WebhookEvent {
  id        String   @id @default(cuid())
  eventName String
  processed Boolean  @default(false)
  body      String   // JSON stringified payload
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  resumeId  String?
  resume    Resume?  @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  action    String   // upload | analyze | rewrite | download | subscribe | login | register
  meta      String?  // JSON additional context
  createdAt DateTime @default(now())
}

model AiLog {
  id             String   @id @default(cuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  taskType       String   // ocr | initial_ats | normalization | rewriting | cover_letter | linkedin | full_analysis
  primaryModel   String   // initial intended model
  usedModel      String   // actual model that succeeded
  provider       String   // moonshot | anthropic | deepseek | gemini
  tokensIn       Int      @default(0)
  tokensOut      Int      @default(0)
  costUsd        Float    @default(0.0)
  responseTimeMs Int      @default(0)
  status         String   @default("success") // success | fallback | error
  failoverCount  Int      @default(0)
  errorMessage   String?
  createdAt      DateTime @default(now())
}
