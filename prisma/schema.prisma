// Prisma schema - Career Analyst Platform
// PostgreSQL - via Supabase for users, resumes, analyses, subscriptions

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  phone        String?
  profession   String?
  // Role & Permissions
  role         String   @default("user") // user | admin
  // Plan management (Phase 1 - simple flag-based; Phase 2 - integration with payment gateway)
  plan         String   @default("free") // free | day | monthly | annual
  planStartsAt DateTime?
  planEndsAt   DateTime?
  // For Phase 2: B2B recruiter marketplace consent
  recruiterOptIn Boolean @default(false)
  // Profile visibility for future recruiter search (Phase 2)
  profileVisible Boolean @default(false)
  // Audit
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  resumes       Resume[]
  subscriptions Subscription[]
  auditLogs     AuditLog[]
  aiLogs        AiLog[]
}

model SystemConfig {
  id        String   @id @default("global")
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Resume {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Original uploaded content (plain text / markdown)
  originalContent  String
  originalFormat   String   @default("text") // text | markdown
  // Analysis output as JSON (scores + strengths + weaknesses + recommendations)
  analysisJson     String?
  // Rewritten resume content (markdown)
  rewrittenContent String?
  // Status flow: uploaded -> analyzed -> rewrite_requested -> rewritten -> confirmed
  status           String   @default("uploaded")
  // Token / cost tracking for pricing model
  analysisTokensIn  Int     @default(0)
  analysisTokensOut Int     @default(0)
  rewriteTokensIn   Int     @default(0)
  rewriteTokensOut  Int     @default(0)
  analysisCostUsd   Float   @default(0)
  rewriteCostUsd    Float   @default(0)
  // Social links & presence analysis
  socialLinksJson   String?
  socialConsent     Boolean  @default(false)
  // Audit
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  auditLogs AuditLog[]
  aiLogs    AiLog[]
}

model Subscription {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan       String   // day | monthly | annual
  priceBrl   Float
  startsAt   DateTime @default(now())
  endsAt     DateTime
  status     String   @default("active") // active | expired | cancelled
  paymentRef String?  // For Phase 2 payment gateway integration
  createdAt  DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  resumeId  String?
  resume    Resume?  @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  action    String   // register | login | upload | analyze | rewrite | download | subscribe | failover
  meta      String?  // JSON string with extra info
  ipHash    String?  // hashed IP for security audit
  createdAt DateTime @default(now())
}

model AiLog {
  id             String   @id @default(cuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  resumeId       String?
  resume         Resume?  @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  taskType       String   // full_analysis | rewrite | ocr_extraction | normalization | social_advice
  primaryModel   String   // e.g. kimi-k3
  usedModel      String   // e.g. claude-3-5-sonnet (if failover occurred)
  provider       String   // kimi | claude | deepseek | gemini
  tokensIn       Int      @default(0)
  tokensOut      Int      @default(0)
  costUsd        Float    @default(0)
  responseTimeMs Int      @default(0)
  status         String   @default("success") // success | failover | error
  errorCode      String?  // 429, 500, 502, 503, 504, timeout, etc.
  failoverCount  Int      @default(0)
  createdAt      DateTime @default(now())
}
