// Prisma schema - Career Analyst Platform
// PostgreSQL - via Supabase for users, resumes, analyses, subscriptions

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters", "queryCompiler"]
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  name                  String?
  passwordHash          String
  phone                 String?
  profession            String?
  socialLinks           String? // JSON string storing saved social networks { "LinkedIn": "...", "Gupy": "..." }
  // Role & Permissions
  role                  String    @default("user") // user | admin
  disabled              Boolean   @default(false) // Account status: false = active, true = disabled
  /// Análises completas disponíveis. Uma delas destrava TODOS os itens de um
  /// currículo — laudo, comparação com a vaga, reescrita, orientação,
  /// otimização de perfil, mídias sociais, carta, resumo e PDF. Não há mais
  /// consumo por ação.
  analysisBalance       Int       @default(0)
  /// País do meio de pagamento da última compra confirmada.
  ///
  /// É ELE que define a faixa de preço nas compras seguintes. O IP serve para
  /// sugerir a moeda de exibição antes da primeira compra e para nada além
  /// disso: um usuário atrás de VPN não escolhe a própria faixa.
  paymentCountry        String?
  /// Prévia gratuita já usada. Uma por conta — é o que evita que a análise
  /// paga seja obtida de graça abrindo currículos novos.
  freePreviewAt         DateTime?
  /// Saldo do modelo antigo de créditos, mantido apenas como rastro da
  /// migração (25 créditos = 1 análise, arredondando a favor do usuário). Nada
  /// no produto lê ou escreve este campo depois da conversão; ele existe para
  /// que a conversão seja auditável e reversível.
  credits               Int       @default(0)
  creditsMigratedAt     DateTime?
  plan                  String    @default("free") // free | day | monthly | annual
  planStartsAt          DateTime?
  planEndsAt            DateTime?
  // For Phase 2: B2B recruiter marketplace consent
  recruiterOptIn        Boolean   @default(false)
  /// Consentimento explícito de transferência internacional de dados.
  /// O currículo é processado por provedores de IA fora do país de origem;
  /// LGPD Art. 33 e GDPR Cap. V exigem base jurídica registrada para isso.
  dataTransferConsent   Boolean   @default(false)
  dataTransferConsentAt DateTime?
  // Profile visibility for future recruiter search (Phase 2)
  profileVisible        Boolean   @default(false)
  // Audit
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  resumes             Resume[]
  subscriptions       Subscription[]
  auditLogs           AuditLog[]
  aiLogs              AiLog[]
  creditTransactions  CreditTransaction[]
  analysisLedger      AnalysisLedger[]
  incidents           SystemIncident[]
  sessions            Session[]
  analysisJobs        AnalysisJob[]
  aiJobs              AiJob[]
  professionalProfile ProfessionalProfile?
  radarPreference     RadarPreference?
  radarAlerts         RadarAlert[]
  radarOfferLog       RadarOfferLog[]

  // Griffo Enterprise (B2B) — ver Organization/OrganizationMembership abaixo.
  organizationMemberships OrganizationMembership[]
  candidateSubmissions    CandidateSubmission[]
}

/// Quem a pessoa é profissionalmente, e onde ela quer trabalhar.
///
/// ## Por que é uma tabela e não campos no `User`
///
/// `User` responde por conta, cobrança e permissão. Este modelo responde por
/// carreira. Misturá-los foi justamente o que produziu o defeito que esta
/// tabela existe para não repetir: `paymentCountry` — o país do cartão — era o
/// único país que o sistema conhecia, e por isso acabava usado como se fosse o
/// país onde a pessoa quer trabalhar. São coisas diferentes. Um brasileiro
/// pagando em real e mirando Lisboa tem `paymentCountry = BR` e mercado-alvo
/// `PT`, e nenhum dos dois valores substitui o outro.
///
/// ## Três eixos que não se confundem
///
/// **Residência** é onde a pessoa está. **Mercado-alvo** é onde ela quer
/// trabalhar. **País de pagamento** é de onde vem o dinheiro, e vive em `User`
/// porque é assunto de cobrança. Os três podem divergir ao mesmo tempo, e é o
/// caso normal de quem procura trabalho no exterior.
///
/// ## Campos JSON
///
/// Listas são gravadas como JSON em `String`, seguindo o que o resto do schema
/// já faz (`socialLinks`, `analysisJson`, `segmentsJson`). A leitura e a
/// escrita passam por `lib/profile/`, que valida — nenhuma rota deve fazer
/// `JSON.parse` destes campos por conta própria.
///
/// ## Tudo anulável
///
/// O perfil é preenchido aos poucos, e um perfil vazio precisa ser um estado
/// válido: ninguém deve ser barrado de usar o produto por não ter declarado a
/// pretensão salarial. O que estiver preenchido é usado; o que faltar cai nas
/// origens anteriores — ver `resolveMarket` em `lib/market/`.
model ProfessionalProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // --- Identidade profissional ---
  /// Cargo atual, no vocabulário do mercado da pessoa.
  currentTitle    String?
  /// intern | junior | mid | senior | lead | principal | director | executive
  seniority       String?
  /// Área de atuação (Dados, Marketing, Enfermagem...).
  field           String?
  /// JSON array de especializações.
  specializations String?
  /// JSON array de competências.
  skills          String?
  yearsExperience Int?
  /// none | high_school | technical | bachelor | postgrad | master | phd
  educationLevel  String?

  // --- Objetivos ---
  /// JSON array de cargos-alvo.
  targetRoles      String?
  /// JSON array de áreas-alvo.
  targetFields     String?
  /// JSON array de setores de interesse.
  targetIndustries String?
  /// Trajetória desejada, em texto livre.
  careerGoal       String?

  // --- Mobilidade (§7: residência e destino são coisas separadas) ---
  /// Onde a pessoa está hoje. ISO-3166 alpha-2.
  residenceCountry          String?
  residenceRegion           String?
  residenceCity             String?
  /// Mercado principal onde quer trabalhar. É o `targetCountry` que
  /// `resolveMarket` consome, e a razão de ser desta tabela.
  primaryMarket             String?
  /// JSON array de mercados alternativos (§8: uma pessoa pode ter vários).
  alternativeMarkets        String?
  openToRelocation          Boolean @default(false)
  /// Trabalho remoto para empresa de outro país. Não é o mesmo que mudar de
  /// país, e por isso é uma pergunta própria.
  openToInternationalRemote Boolean @default(false)

  // --- Preferências de trabalho ---
  /// JSON array: remote | hybrid | onsite
  workModes     String?
  /// JSON array de tipos de contrato aceitos, no vocabulário do mercado.
  contractTypes String?
  /// full_time | part_time | flexible
  weeklyHours   String?

  // --- Pretensão salarial (§33: moeda de salário ≠ moeda de cobrança) ---
  salaryMin      Float?
  salaryMax      Float?
  /// Moeda da PRETENSÃO. A moeda em que o usuário paga pelo produto é decidida
  /// pelo país do meio de pagamento, em `lib/pricing/`, e não tem relação com
  /// esta. Quem mira Londres pensa o salário em GBP e paga em BRL.
  salaryCurrency String?
  /// year | month | hour
  salaryPeriod   String?

  // --- Idiomas (§32: cinco idiomas diferentes, três guardados aqui) ---
  /// Idioma em que o currículo deve ser produzido. Não é o idioma da
  /// interface: quem mora no Brasil e busca vaga nos EUA lê a tela em
  /// português e precisa do currículo em inglês.
  resumeLanguage        String?
  /// Idioma dos e-mails e avisos.
  communicationLanguage String?
  /// JSON array de idiomas falados: [{ "code": "en", "level": "advanced" }].
  spokenLanguages       String?

  /// Moeda preferida para EXIBIR valores de salário. Não cobra nada.
  displayCurrency String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Sessões ativas, para que o logout invalide de verdade.
///
/// Antes a sessão vivia só no cookie assinado por HMAC: o servidor não
/// guardava nada, então "sair" apenas apagava o cookie do navegador. Um token
/// copiado antes disso continuava válido até expirar, e não havia como
/// revogá-lo — nem no logout, nem ao desabilitar a conta, nem em caso de
/// vazamento.
model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?

  @@index([userId])
  @@index([expiresAt])
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

model AiApiKey {
  id        String   @id @default(cuid())
  name      String // Name/Label (e.g., "Kimi K3 Produção")
  provider  String // moonshot | anthropic | deepseek | gemini
  apiKey    String // Secret API key
  baseUrl   String? // Custom base URL if needed
  model     String // Target AI model string
  status    String   @default("active") // active | paused
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Resume {
  id                   String  @id @default(cuid())
  userId               String
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Original uploaded content (plain text / markdown)
  originalContent      String
  originalFormat       String  @default("text") // text | markdown
  // Analysis output as JSON (scores + strengths + weaknesses + recommendations)
  analysisJson         String?
  // Rewritten resume content (markdown)
  rewrittenContent     String?
  // ATS target check results
  atsScore             Int?
  // Target job title / industry if provided
  targetJob            String?
  targetJobDescription String?
  jobMatchJson         String?
  // Social links submitted with resume (JSON stringified record)
  socialLinksJson      String?
  // User consent for social links evaluation
  socialConsent        Boolean @default(false)

  // Career orientation analysis JSON
  careerOrientationJson String?

  /// Resultado da análise de presença digital (rota social-analysis).
  /// Roda numa rota própria porque juntá-la ao laudo agravaria o orçamento de
  /// tempo da análise — não porque seja cobrada à parte: desde a
  /// reprecificação nada é cobrado à parte.
  socialAnalysisJson String?

  /// Prévia gratuita: só as notas de 0 a 10 das 8 dimensões, sem diagnóstico e
  /// sem texto. É o que a pessoa vê antes de pagar.
  previewJson String?

  /// Carta de apresentação e resumo profissional direcionado.
  ///
  /// Os dois eram anunciados na landing, no catálogo e no prompt do suporte
  /// desde a reprecificação, e não existiam no código: `cover_letter` tinha
  /// tipo de tarefa, roteamento para o Claude e custo orçado, mas nenhuma rota
  /// que o produzisse. Uma compra entregava sete dos nove itens vendidos.
  ///
  /// Guardados juntos porque saem da mesma chamada: os dois textos derivam do
  /// par (currículo, vaga alvo) e pedi-los separadamente dobraria o custo sem
  /// melhorar nenhum dos dois.
  coverLetterJson String?

  /// Momento em que uma análise do saldo foi consumida para destravar ESTE
  /// currículo. A partir daqui todos os nove itens ficam disponíveis, quantas
  /// vezes o usuário quiser, sem nova cobrança.
  unlockedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  auditLogs    AuditLog[]
  analysisJobs AnalysisJob[]
  aiJobs       AiJob[]

  @@index([userId, createdAt])
}

model Subscription {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan       String // day | monthly | annual
  priceBrl   Float
  startsAt   DateTime @default(now())
  endsAt     DateTime
  status     String   @default("active") // active | cancelled | expired
  paymentRef String? // gateway ref

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
  @@index([status])
}

/// Histórico do modelo de créditos, encerrado na reprecificação.
///
/// Nada escreve mais aqui: o saldo virou análises completas e o movimento novo
/// vive em `AnalysisLedger`. A tabela permanece porque é o comprovante das
/// compras já feitas — apagá-la destruiria o rastro fiscal de quem comprou
/// antes da mudança.
model CreditTransaction {
  id             String  @id @default(cuid())
  userId         String
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount         Int // positive for purchase/grant, negative for deduction
  type           String // welcome | purchase | spend | refund | admin_gift
  description    String
  costBrl        Float?
  /// Moeda em que a compra foi efetivamente cobrada (brl | usd | eur).
  /// `costBrl` gravava `amount_total / 100` sem conversão, qualquer que fosse
  /// a moeda do checkout — somar essa coluna misturava reais, dólares e euros
  /// como se fossem a mesma unidade.
  currency       String  @default("brl")
  /// Valor cobrado na moeda acima, sem conversão. A conversão passa a ser
  /// feita na leitura, com a cotação do momento, e não gravada na escrita.
  amountOriginal Float?
  paymentRef     String? @unique // Stripe Session ID - unique constraint prevents double-spending
  /// pending  = reserva em aberto, crédito já debitado do saldo
  /// completed = entrega confirmada, cobrança definitiva
  /// refunded  = reserva liberada, crédito devolvido ao saldo
  status         String  @default("completed")

  createdAt DateTime @default(now())

  /// Sustenta a varredura de reservas órfãs em `releaseStaleReservations`.
  @@index([userId, status])
}

/// Ledger auditável das análises.
///
/// Cada linha explica um movimento de saldo e carrega o que é preciso para
/// conferir a cobrança depois: a faixa aplicada, o preço em dólar e o país do
/// meio de pagamento que decidiu a faixa. Sem essas três colunas não há como
/// verificar, meses depois, se um comprador pagou o preço da região certa.
model AnalysisLedger {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// purchase | unlock | migration | admin_grant | refund
  type        String
  /// +N em compra e migração, -1 no destrave de um currículo.
  delta       Int
  description String

  /// Faixa de preço aplicada (1..4). Nula em movimentos sem cobrança.
  tier           Int?
  /// Preço pago convertido para dólar pela cotação de referência do catálogo.
  priceUsd       Float?
  /// País do meio de pagamento — o que definiu a faixa.
  paymentCountry String?
  /// Moeda e valor efetivamente cobrados, sem conversão.
  currency       String?
  amountLocal    Float?

  /// Currículo destravado, nos movimentos de tipo `unlock`.
  resumeId String?

  /// `checkout.session.id`. O índice único é o que impede creditar duas vezes
  /// o mesmo pagamento, venha ele pelo webhook ou pela verificação direta.
  paymentRef    String? @unique
  /// `event.id` da Stripe, para rastrear qual entrega gerou a linha.
  stripeEventId String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model WebhookEvent {
  id        String   @id @default(cuid())
  eventName String
  /// `event.id` da Stripe. Único: a idempotência do webhook é a falha desta
  /// inserção, não uma consulta anterior — duas entregas simultâneas do mesmo
  /// evento passariam por qualquer verificação feita antes da escrita.
  eventId   String?  @unique
  processed Boolean  @default(false)
  body      String // JSON stringified payload
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Execução de uma análise, desacoplada da requisição HTTP que a pediu.
///
/// A análise era feita dentro do POST /api/resume/analyze, o que a prendia a
/// três limites que não são dela: o `maxDuration` de 60s da função, a vida da
/// conexão TCP e a permanência do usuário na página. Estourar qualquer um dos
/// três matava o trabalho já pago — e junto com ele o `catch` que devolveria os
/// créditos, que só eram recuperados depois pela varredura de reservas órfãs.
///
/// Com o trabalho numa linha própria, a rota responde na hora com o `id`, o
/// processamento grava o progresso aqui, e fechar o navegador deixa de ser
/// perda: o laudo continua sendo escrito e está pronto na volta.
model AnalysisJob {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  status String @default("queued") // queued | running | completed | failed

  /// Resultados por segmento, acumulados conforme cada um termina:
  /// `{ "dimensions_a": {...}, "job_match": {...} }`. É o que torna o trabalho
  /// retomável — quem reassume pula o que já está aqui — e o que alimenta a
  /// tela com conteúdo real antes do laudo ficar completo.
  segmentsJson String?
  /// Laudo final montado a partir dos segmentos. Preenchido junto com
  /// `Resume.analysisJson` no fecho.
  resultJson   String?
  errorMessage String?

  /// Idioma e país capturados no pedido: quem retoma o trabalho numa invocação
  /// posterior não tem mais os cabeçalhos da requisição original.
  lang        String  @default("pt")
  userCountry String?

  /// Concessão de exclusividade sobre o processamento, renovada a cada segmento
  /// concluído. Uma execução morta pela plataforma deixa a concessão vencer, e a
  /// próxima consulta de status reassume o trabalho de onde parou — sem isto,
  /// um job interrompido ficaria parado para sempre esperando alguém retomá-lo.
  leaseUntil DateTime?
  attempts   Int       @default(0)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  finishedAt DateTime?

  @@index([resumeId, createdAt])
  @@index([userId, createdAt])
  @@index([status, leaseUntil])
}

/// Execução em segundo plano para tarefas de IA fora do laudo principal —
/// leitura de perfil social, extração de perfil, orientação vocacional,
/// carta de apresentação, reescrita do currículo e preparo de entrevista
/// (ver HANDOFF-CONTINUIDADE.md, "Nunca dar sensação de travamento", e 2.35
/// na auditoria).
///
/// Mesmo desenho de concessão/retomada do `AnalysisJob`, mas genérico por
/// `kind`: este model NÃO substitui o `AnalysisJob` do laudo — que continua
/// intacto — e sim cobre os outros seis fluxos, que antes respondiam de
/// forma síncrona e mostravam só um spinner com aviso de tempo estimado.
model AiJob {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  /// social_advice | profile_extraction | career_orientation | cover_letter | rewrite | interview_prep
  kind   String
  status String @default("queued") // queued | running | completed | failed

  /// Progresso real por etapa, formato depende do `kind` — por exemplo,
  /// `{ "linkedin": {...}, "overall": {...} }` na leitura de perfil social, ou
  /// `{ "attempt_1": { "provider": "deepseek", "at": "..." } }` numa tarefa de
  /// chamada única. É o que torna o número mostrado na tela um fato, não uma
  /// estimativa — a mesma exigência que já vale para o `AnalysisJob`.
  stepsJson  String?
  totalSteps Int

  resultJson   String?
  errorMessage String?

  /// Entrada preparada pela rota ANTES de criar o job — por exemplo, os
  /// perfis sociais já buscados (com conteúdo do LinkedIn em PDF ou colado à
  /// mão) na leitura de perfil social. Existe porque essa preparação é cara e
  /// específica do pedido: refazê-la dentro do `after()` duplicaria buscas
  /// externas (GitHub, Jina) e perderia conteúdo que só existiu na requisição
  /// original. Tarefas de chamada única não usam este campo — recarregam o
  /// currículo pelo `resumeId`, que já basta.
  inputJson String?

  /// Idioma e país capturados no pedido: quem retoma o trabalho numa invocação
  /// posterior não tem mais os cabeçalhos da requisição original.
  lang        String  @default("pt")
  userCountry String?

  /// Concessão de exclusividade, renovada a cada etapa concluída — mesmo
  /// papel do `leaseUntil` do `AnalysisJob`.
  leaseUntil DateTime?
  attempts   Int       @default(0)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  finishedAt DateTime?

  @@index([resumeId, kind, createdAt])
  @@index([userId, createdAt])
  @@index([status, leaseUntil])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  resumeId  String?
  resume    Resume?  @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  action    String // upload | analyze | rewrite | download | subscribe | login | register
  meta      String? // JSON additional context
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([resumeId])
}

model AiLog {
  id             String   @id @default(cuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  taskType       String // ocr | initial_ats | normalization | rewriting | cover_letter | linkedin | full_analysis
  primaryModel   String // initial intended model
  usedModel      String // actual model that succeeded
  provider       String // moonshot | anthropic | deepseek | gemini
  tokensIn       Int      @default(0)
  tokensOut      Int      @default(0)
  costUsd        Float    @default(0.0)
  responseTimeMs Int      @default(0)
  status         String   @default("success") // success | fallback | error
  failoverCount  Int      @default(0)
  errorMessage   String?
  createdAt      DateTime @default(now())

  /// Veredito do juiz de qualidade (P10). Preenchido de forma assíncrona e
  /// amostrada, DEPOIS da resposta ao usuário — nunca no caminho dela.
  /// Nulo significa "não sorteado", não "reprovado".
  qualityScore    Float?
  qualityNotes    String?
  qualityJudgedAt DateTime?

  @@index([createdAt])
  @@index([userId])
  @@index([provider, createdAt])
  @@index([taskType, createdAt])
}

model SystemIncident {
  id               String   @id @default(cuid())
  reportedByUserId String?
  user             User?    @relation(fields: [reportedByUserId], references: [id], onDelete: SetNull)
  title            String
  description      String
  severity         String   @default("medium") // low | medium | high | critical
  status           String   @default("investigating") // investigating | auto_fixed | action_required | resolved
  diagnosticResult String? // JSON with simulation and test results
  alertSent        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
}

/// Uma fonte de vagas — um ATS, um portal, a página de carreiras de uma empresa.
///
/// A tabela existe principalmente por causa do §12 do prompt mestre, que é a
/// regra mais importante de toda a coleta:
///
/// > NUNCA marcar vagas como encerradas simplesmente porque uma coleta
/// > retornou zero resultados.
///
/// HTTP 200 com lista vazia pode ser manutenção, mudança de endpoint, falha do
/// adapter, bloqueio, erro de paginação ou indisponibilidade temporária. Fechar
/// as vagas nesse momento apaga oportunidades reais dos usuários e não há como
/// distinguir depois o que foi encerrado de verdade do que foi apagado por
/// engano. Por isso o estado da coleta é gravado, e o encerramento exige
/// evidência — ver `lib/jobs/collection.ts`.
model JobSource {
  id   String @id @default(cuid())
  /// Identificador estável do adapter: `greenhouse`, `lever`, `gupy`...
  slug String @unique
  name String

  /// Mercados em que esta fonte é relevante. JSON array de MarketId.
  markets String?
  /// ats | job_board | company_careers | api | feed
  kind    String  @default("ats")

  enabled Boolean @default(true)

  /// ok | empty_unexpected | error | never_collected
  ///
  /// `empty_unexpected` é o estado que o §12 criou: a coleta respondeu, veio
  /// vazia, e havia vagas abertas antes. Não é sucesso nem erro de transporte —
  /// é suspeita, e suspeita não fecha vaga.
  collectionStatus String  @default("never_collected")
  collectionError  String?

  lastCollectionAt         DateTime?
  /// Última coleta que foi considerada CONFIÁVEL. É esta data, e não a de
  /// cima, que autoriza encerrar vagas ausentes.
  lastSuccessfulCollection DateTime?

  /// Coletas consecutivas com resultado suspeito. Alimenta o alerta do painel.
  consecutiveFailures Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs Job[]

  @@index([enabled, collectionStatus])
}

/// Uma vaga, normalizada (§13).
///
/// O formato interno é comum a todas as fontes: o adapter converte, e daqui
/// para a frente ninguém precisa saber de onde a vaga veio.
///
/// **Campo ausente não é campo vazio.** O §13 é explícito: nem todo mercado
/// preenche tudo, e os campos precisam suportar *desconhecido*, *não informado*
/// e *não aplicável*. Aqui isso é `null` na coluna mais o registro do motivo em
/// `unknownFields` — sem essa distinção, "salário não divulgado" e "salário
/// zero" viram a mesma coisa no filtro.
model Job {
  id String @id @default(cuid())

  sourceId    String
  source      JobSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  /// Identificador da vaga NA FONTE. Junto de `company`, é a chave de
  /// deduplicação preferida (§14).
  sourceJobId String?

  company         String
  /// Empresa em forma canônica (sem acento, sem Ltda/Inc), para deduplicar.
  companyKey      String
  title           String
  /// Conceito da taxonomia (`data_analyst`), quando reconhecido. `null` é uma
  /// resposta válida: título desconhecido não vira o vizinho mais próximo.
  normalizedTitle String?
  /// Setor amplo (`ti`, `vendas`, `vaga_remota`...) — diferente de
  /// `normalizedTitle` (cargo fino, taxonomia própria do Griffo, ~24% de
  /// cobertura): vem do `category_slug` do JobBase (gerado por título,
  /// ~74% de cobertura), com `vaga_remota` sobrepondo quando `remoteType`
  /// é `remote` (pedido do operador — ver `normalize.ts`). `null` quando a
  /// fonte não categoriza (Gupy/Adzuna/Greenhouse/Remotive/RemoteOK).
  category        String?

  country    String?
  region     String?
  city       String?
  /// remote | hybrid | onsite | unknown
  remoteType String  @default("unknown")
  /// Mercado a que esta vaga pertence, resolvido pela camada de mercado.
  market     String?

  /// Vínculo, no vocabulário do mercado da vaga.
  employmentType String?
  /// intern | junior | mid | senior | lead | principal | director | executive
  seniority      String?

  salaryMin    Float?
  salaryMax    Float?
  currency     String?
  /// year | month | hour
  salaryPeriod String?

  description  String?
  /// JSON array de requisitos extraídos.
  requirements String?
  /// JSON array de competências extraídas.
  skills       String?
  /// Idioma em que a vaga está escrita.
  language     String?

  applicationUrl String
  /// Chave de deduplicação efetivamente usada. Única: é ela que impede a mesma
  /// vaga entrar duas vezes vinda de duas fontes.
  dedupeKey      String @unique

  publishedAt  DateTime?
  /// Quando esta vaga foi vista pela última vez numa coleta CONFIÁVEL.
  lastSeenAt   DateTime  @default(now())
  /// Preenchido só com evidência suficiente — ver §12 e lib/jobs/collection.ts.
  closedAt     DateTime?
  /// Por que foi encerrada: absent_from_reliable_collection | source_reported |
  /// expired_by_age | manual. Sem isto não há como auditar um fechamento errado.
  closedReason String?

  /// Campos que a fonte não trouxe, e por quê. JSON:
  /// `{ "salaryMin": "not_disclosed", "seniority": "unknown" }`.
  /// Distingue "não informado" de "não aplicável" e de "zero".
  unknownFields String?

  /// Inteligência da vaga, gerada UMA vez por vaga e reaproveitada entre
  /// usuários (§27). Separada da compatibilidade, que é por usuário.
  intelligenceJson String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  radarAlerts RadarAlert[]

  @@index([sourceId, lastSeenAt])
  @@index([market, closedAt])
  @@index([companyKey, normalizedTitle])
  @@index([closedAt, publishedAt])
}

/// Empresa cliente do Griffo Enterprise (B2B) — decidido em 2026-09-10.
/// Plataforma separada do Griffo consumer, mas mesmo banco: isolamento de
/// tenant é lógico, por `organizationId`, igual ao resto do schema já isola
/// por `userId`. Não tem billing próprio ainda — ver `matchThreshold` e
/// `marketplaceEnabled` para o que já é configurável por empresa.
model Organization {
  id   String @id @default(cuid())
  name String
  /// Usado em rotas do Enterprise (`/enterprise/[slug]`).
  slug String @unique

  /// Corte mínimo de compatibilidade (0–100) para o agente de match sugerir
  /// um candidato automaticamente ao criar uma `JobRequisition`. Produto
  /// nasce em 80, configurável por empresa.
  matchThreshold Float @default(80)

  /// Libera a 3ª fonte da cascata do agente de match — o pool de opt-in do
  /// Griffo consumer (`User.recruiterOptIn`), além de time interno e base
  /// própria. Fica desligado por padrão porque é alcance extra, possivelmente
  /// um add-on pago.
  marketplaceEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships          OrganizationMembership[]
  jobRequisitions      JobRequisition[]
  candidateSubmissions CandidateSubmission[]
}

/// Liga um `User` já existente do Griffo a uma `Organization`, com o papel
/// que exerce ali. É também o mecanismo de mobilidade interna: um
/// funcionário é `role = employee` e concorre a `JobRequisition` internas
/// usando o mesmo `ProfessionalProfile` que já mantém no Griffo consumer —
/// sem duplicar dado, sem a organização escrever nele.
model OrganizationMembership {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// admin | recruiter | hiring_manager | employee
  role   String
  // active | invited | removed
  status String @default("active")

  /// Consentimento explícito de QUE ESTA organização veja o
  /// `ProfessionalProfile` do funcionário para efeito de vagas internas —
  /// escopado por empresa, diferente do `User.recruiterOptIn`, que é global
  /// pro marketplace.
  internalMobilityConsent   Boolean   @default(false)
  internalMobilityConsentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  decidedSubmissions CandidateSubmission[] @relation("SubmissionDecidedBy")

  @@unique([organizationId, userId])
  @@index([organizationId, role])
}

/// Vaga criada por uma `Organization` no Griffo Enterprise. Não confundir com
/// `Job`: aquele é raspado de fontes externas via `JobSource` e não pertence
/// a ninguém — este é autoral, tem dono e ciclo de vida próprio. Mesmo shape
/// de campos de mercado que `Job`, de propósito, para caber sem tradução em
/// `matching/compatibility.ts` (`NormalizedJob`).
model JobRequisition {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title           String
  normalizedTitle String?

  country    String?
  region     String?
  city       String?
  /// remote | hybrid | onsite | unknown
  remoteType String  @default("unknown")
  market     String?

  employmentType String?
  /// intern | junior | mid | senior | lead | principal | director | executive
  seniority      String?

  salaryMin    Float?
  salaryMax    Float?
  currency     String?
  /// year | month | hour
  salaryPeriod String?

  description  String?
  /// JSON array de requisitos.
  requirements String?
  /// JSON array de competências.
  skills       String?
  language     String?

  // open | paused | closed
  status String @default("open")

  /// Concessão de exclusividade do agente de match automático, mesmo papel
  /// do `leaseUntil` de `AnalysisJob`/`AiJob` — uma varredura morta não fica
  /// travada esperando alguém retomar. A varredura roda em cascata: time
  /// interno → base cadastrada da empresa → marketplace Griffo (se
  /// `Organization.marketplaceEnabled`), escrevendo um `CandidateSubmission`
  /// por candidato encontrado, incrementalmente — igual o `AnalysisJob`
  /// escreve `segmentsJson` conforme cada etapa termina.
  matchScanStatus      String    @default("pending") // pending | running | completed | failed
  matchScanLeaseUntil  DateTime?
  matchScanAttempts    Int       @default(0)
  matchScanStartedAt   DateTime?
  matchScanCompletedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  candidateSubmissions CandidateSubmission[]

  @@index([organizationId, status])
  @@index([matchScanStatus, matchScanLeaseUntil])
}

/// Um candidato avaliado contra uma `JobRequisition`, gerado pelo agente de
/// match automático em cascata OU lançado manualmente por um recrutador.
/// `source` é obrigatório e sempre mostrado na apresentação junto do score —
/// a origem faz parte da decisão do recrutador, não é metadado escondido
/// (decisão de produto de 2026-09-10).
model CandidateSubmission {
  id               String         @id @default(cuid())
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobRequisitionId String
  jobRequisition   JobRequisition @relation(fields: [jobRequisitionId], references: [id], onDelete: Cascade)

  /// Preenchido quando o candidato é um `User` já existente do Griffo — time
  /// interno (via `OrganizationMembership`) ou opt-in do marketplace. `null`
  /// quando é um currículo cadastrado direto na empresa, sem conta Griffo.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Snapshot do perfil no formato de `ProfessionalProfile`, usado só quando
  /// não há `userId` — currículo recebido pela empresa e extraído via
  /// `profile/extract.ts` (mesma extração do Griffo consumer), sem virar
  /// conta na plataforma. Fonte 2 da cascata, MVP: cadastro/upload direto —
  /// importação de outras plataformas de RH (Gupy, Workday etc.) fica para
  /// fase 2, demand-driven, seguindo o padrão de `lib/jobs/adapters/`.
  profileJson String?

  /// internal | registered | marketplace — de qual fonte da cascata este
  /// candidato veio. Ver comentário acima: sempre exibido ao recrutador.
  source String

  /// 0–100, saída de `matching/compatibility.ts`.
  matchScore      Float?
  /// Decomposição completa (`professionalAxis`/`jobFitAxis`/`contextualAxis`),
  /// mesmo papel do `segmentsJson` do `AnalysisJob`.
  matchResultJson String?

  // new | shortlisted | rejected | hired
  status                String                  @default("new")
  decidedByMembershipId String?
  decidedByMembership   OrganizationMembership? @relation("SubmissionDecidedBy", fields: [decidedByMembershipId], references: [id], onDelete: SetNull)
  decidedAt             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobRequisitionId, userId])
  @@index([jobRequisitionId, matchScore])
  @@index([organizationId, status])
}

/// Como o usuário quer ser interrompido pelo Radar (§22).
///
/// Tabela própria, e não campos no `User`, pela mesma razão do
/// `ProfessionalProfile`: `User` responde por conta e cobrança. Isto responde
/// por atenção — quanto dela a pessoa autoriza o produto a consumir.
///
/// O padrão de fábrica é exigente de propósito. Ver `DEFAULT_RADAR_PREFERENCES`
/// em `lib/radar/curation.ts`: um Radar que avisa demais se desliga sozinho na
/// cabeça do usuário.
model RadarPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// immediate | daily | weekly | off
  frequency    String @default("daily")
  /// strong | good | partial — relevância mínima para interromper.
  minimumFit   String @default("good")
  /// Teto de oportunidades por envio. Acima disto vira lista, não curadoria.
  maxPerDigest Int    @default(4)

  /// Última vez que o Radar rodou para este usuário. É por este campo que a
  /// rodada escolhe quem atender primeiro, o que dá rotação justa quando há
  /// mais usuários do que cabe numa invocação.
  lastRunAt DateTime?

  /// Quantas buscas avulsas (coleta ao vivo, não a diária) este usuário já
  /// gastou na janela atual. Benefício de quem já destravou uma Análise
  /// Completa — ver `requireAnyUnlockedResume` em `lib/entitlements.ts` — e
  /// não uma cota de infraestrutura, por isso vive aqui e não em `quota.ts`.
  onDemandSearchCount       Int       @default(0)
  /// Início da janela rolante de 7 dias usada para zerar o contador acima.
  /// Rolante a partir do primeiro uso, não semana de calendário — ver
  /// `lib/radar/on-demand-search.ts`.
  onDemandSearchWindowStart DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([frequency, lastRunAt])
}

/// Uma oportunidade que o Radar decidiu mostrar a alguém.
///
/// Guarda o veredito COMO ELE ERA no momento do alerta. Recalcular na leitura
/// mudaria o que a pessoa viu — o perfil dela pode ter mudado desde então — e
/// tornaria impossível auditar por que aquele alerta foi enviado.
///
/// É também onde vive o feedback do §30. O prompt é explícito: o feedback pode
/// melhorar o perfil e o matching, mas NÃO pode alterar o perfil silenciosamente
/// — por isso ele fica aqui, junto do alerta que o motivou, e não escrito de
/// volta no `ProfessionalProfile`.
model RadarAlert {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId  String
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  /// strong | good | partial | weak, no momento do alerta.
  overallFit     String
  /// apply | consider | stretch | skip
  recommendation String
  /// `MatchResult` inteiro, serializado. É o que a tela do Job Fit lê.
  matchJson      String

  /// Sinal interno de ordenação. NUNCA exibido — ver §9 e §17.
  signalScore Int @default(0)

  seenAt    DateTime?
  clickedAt DateTime?

  /// Quando este alerta saiu num e-mail. Nulo = ainda não foi enviado.
  ///
  /// É este campo — e não uma data no `RadarPreference` — que garante o "não se
  /// avisa duas vezes" do §15 também por e-mail. Uma marca por USUÁRIO diria
  /// apenas "houve um envio naquele dia"; qualquer alerta criado depois do
  /// envio e antes da virada do dia ficaria de fora para sempre, ou entraria
  /// duas vezes, conforme a comparação escolhida.
  ///
  /// A marca só é gravada DEPOIS que o envio deu certo. Envio que falhou deixa
  /// o campo nulo, e a rodada seguinte tenta de novo — o contrário perderia o
  /// aviso em silêncio, que é o pior desfecho possível aqui.
  notifiedAt DateTime?

  /// §30: 👍 interessante | 👎 não serve. Nulo = ainda não respondeu.
  feedback       String?
  /// wrong_role | location | salary | seniority | skills | company | work_mode | other
  feedbackReason String?
  feedbackAt     DateTime?

  /// Perguntas de entrevista geradas para ESTA vaga e ESTE usuário — não é
  /// inteligência da vaga (`Job.intelligenceJson`, reaproveitada entre
  /// usuários): as perguntas citam as lacunas do MATCH deste usuário, então
  /// são inerentemente por (usuário, vaga), como o próprio alerta. Gerado
  /// uma vez, no clique de "Preparar para a entrevista", e reaproveitado nas
  /// próximas aberturas do painel — nulo até então.
  interviewPrepJson String?

  createdAt DateTime @default(now())

  /// Um alerta por usuário e vaga. É o que garante o "não se avisa duas vezes"
  /// do §15 mesmo quando duas rodadas correm em paralelo: a segunda colide com
  /// o índice em vez de duplicar o aviso.
  @@unique([userId, jobId])
  @@index([userId, createdAt])
  @@index([userId, seenAt])
  /// A rodada do digest pergunta "quem tem alerta ainda não enviado?" antes de
  /// qualquer outra coisa. Sem este índice, essa pergunta vira varredura da
  /// tabela inteira dentro de uma função com teto de 60s.
  @@index([notifiedAt, userId])
}

/// Consumo de cota das APIs externas, por provedor e por mês.
///
/// Existe porque cota estourada é invisível até a fonte parar de responder — e
/// aí a coleta falha em silêncio até alguém reparar. A Adzuna, por exemplo,
/// permite 2.500 requisições por mês e responde 200 com `exception` quando o
/// limite passa, o que se parece com "não há vaga".
///
/// Uma linha por provedor por mês, não uma por requisição: o que interessa é o
/// total, e uma linha por chamada seriam milhares de registros para responder
/// uma pergunta de um número só.
model ApiQuotaUsage {
  id String @id @default(cuid())

  /// `adzuna`, `gupy`, `remotive`... Casa com o prefixo do slug da fonte.
  provider String
  /// `2026-08`. Mês em UTC, para não mudar de bucket conforme o fuso.
  period   String

  /// Requisições contadas no período.
  used Int @default(0)

  /// Teto conhecido do plano, quando há um. Nulo = sem limite declarado.
  limit Int?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([provider, period])
  @@index([period])
}

/// Eventos de telemetria e funil de conversão (visitantes, checkouts e upsell).
model AnalyticsEvent {
  id        String   @id @default(cuid())
  event     String // 'page_view' | 'checkout_initiated' | 'upsell_viewed'
  userId    String?
  visitorId String? // Hash ou identificador anônimo de sessão
  sku       String? // 'single' | 'pack5'
  meta      String? // JSON string com metadados adicionais
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([visitorId, createdAt])
  @@index([userId, createdAt])
}

/// Um ponto de série temporal de mercado de trabalho, por país.
///
/// Matéria-prima do índice de temperatura de contratação. Cada linha é um
/// número que um órgão oficial de estatística publicou para um país num
/// período — nunca um número calculado, interpolado ou estimado por nós.
///
/// **Esta tabela não sustenta ranking entre países, e isso é de propósito.**
/// O próprio Eurostat não publica um total da UE para a taxa de postos vagos
/// porque os países não são comparáveis: a amostra vai de ~2.500 empresas
/// (Finlândia) a ~75.000 (Polônia), a taxa de resposta vai de 11,4%
/// (Alemanha) a 98,8% (Romênia), e a França exclui administração pública e só
/// pesquisa empresas com 10+ empregados. A única comparação válida é um país
/// contra a própria história — e é só isso que `lib/hiring-index/phase.ts`
/// faz.
///
/// Sem `country` no `@@unique`? Não: a chave é o quarteto inteiro. O mesmo
/// período do mesmo país pode ser buscado muitas vezes (o JOLTS revisa a
/// impressão anterior toda divulgação), e o `upsert` faz a leitura mais
/// recente vencer sem duplicar o mês.
model LaborMarketPoint {
  id String @id @default(cuid())

  /// ISO 3166-1 alfa-2. `GR`, nunca o `EL` do Eurostat; `GB`, nunca `UK`.
  country String
  /// Identificador estável do conector: `bls_jolts`, `eurostat_jvs`.
  source  String
  /// `job_openings_rate` | `job_vacancy_rate` | `unemployment_rate`
  ///
  /// Métricas diferentes NÃO se emendam na mesma série: a taxa do JOLTS e a do
  /// Eurostat medem coisas parecidas com definições diferentes, e juntá-las
  /// criaria um degrau artificial que a classificação de fase leria como
  /// virada de mercado.
  metric  String

  value Float
  /// `percent` hoje. Existe para o dia em que uma fonte devolver nível absoluto.
  unit  String @default("percent")

  /// Primeiro dia do período coberto, em UTC. Julho/2026 → `2026-07-01`.
  period     DateTime
  /// `month` | `quarter`
  periodType String

  /// `false` = impressão preliminar/provisória.
  ///
  /// A taxa de resposta do JOLTS caiu de 58% (2019) para ~30% e a revisão da
  /// segunda divulgação passou a valer ~180 mil vagas em média, cerca do dobro
  /// da norma histórica. A primeira impressão de um mês é a menos confiável da
  /// série inteira, e nenhuma tela deve mostrá-la como "o" número.
  revised Boolean @default(false)

  /// A fonte declarou QUEBRA DE SÉRIE neste período.
  ///
  /// O campo mais importante desta tabela, e o menos óbvio. Quebra significa
  /// que os valores antes e depois não são comparáveis ENTRE SI — e comparar o
  /// país com o próprio passado é a única coisa que este produto faz. Sem isto,
  /// uma mudança de metodologia do instituto apareceria na tela como um
  /// mercado esfriando de repente.
  seriesBreak Boolean @default(false)

  /// `high` | `low`
  ///
  /// `high` — pesquisa direta com empregadores sobre vagas em aberto (JOLTS,
  /// Eurostat). `low` — taxa derivada/modelada (ILOSTAT, CEPALSTAT, fase 2),
  /// ou marcada pela própria fonte como pouco confiável. A diferença não é de
  /// grau: em economias com setor informal grande, quem trabalha
  /// informalmente conta como "empregado" sem contratação formal nenhuma por
  /// trás. Fica na COLUNA, e não num tooltip, para sobreviver a qualquer tela
  /// futura escrita por quem não leu isto.
  confidence String @default("high")

  /// Marcação crua da fonte (`p`, `b`, `d`, `e`, `u` no Eurostat; código de
  /// nota de rodapé no BLS). Guardada como veio: é rastro de origem, não texto
  /// de tela.
  note String?

  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([country, source, metric, period])
  @@index([country, metric, period])
  @@index([source, period])
}

/// O que o Radar já ofereceu a uma pessoa — em forma que sobrevive à vaga.
///
/// `RadarAlert` é o alerta vivo: aponta para `Job` com `onDelete: Cascade`, e
/// some junto quando a vaga é apagada. Isso é correto para o alerta (não faz
/// sentido abrir um aviso de uma vaga que não existe mais) e errado para a
/// memória da pessoa: ela continua tendo o direito de saber o que lhe foi
/// oferecido, e quando.
///
/// Por isso esta tabela é **desnormalizada de propósito**: guarda uma cópia dos
/// quatro campos que importam em vez de uma referência. Não há relação com
/// `Job` — nem opcional —, porque qualquer relação reintroduziria a dependência
/// que esta tabela existe para cortar.
///
/// É o que permite `purgeAgedJobs` apagar vaga com alerta e tudo aos 180 dias
/// sem destruir histórico de ninguém.
model RadarOfferLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Id que a vaga tinha no momento da oferta. **Texto puro, sem relação.**
  ///
  /// A primeira versão deste modelo não tinha este campo, por medo de
  /// reintroduzir o `onDelete: Cascade` que apaga o `RadarAlert` junto com a
  /// vaga. O medo estava no lugar errado: o perigo é a RELAÇÃO, não o valor.
  /// Uma coluna de texto não cascateia — ela simplesmente continua lá depois
  /// que a vaga sumiu, que é exatamente o que se quer.
  ///
  /// Ter o id de volta é o que permite deduplicar: sem ele, a escrita no
  /// alerta e o backfill do expurgo criariam duas linhas para a mesma oferta.
  jobId   String
  /// Cargo, como estava no anúncio no dia da oferta.
  title   String
  /// Empresa, idem. Nome de exibição, não a chave de deduplicação.
  company String
  /// País da vaga (ISO-2). Nulo quando a vaga não tinha país resolvido.
  country String?

  /// Quando esta vaga apareceu no Radar desta pessoa.
  offeredAt DateTime @default(now())

  /// Espelha o `@@unique([userId, jobId])` do `RadarAlert`: uma oferta por
  /// pessoa e vaga. É o que torna o backfill do expurgo idempotente — ele pode
  /// rodar quantas vezes for, e `skipDuplicates` cuida do resto.
  @@unique([userId, jobId])
  @@index([userId, offeredAt])
  /// A varredura de retenção filtra só por `offeredAt`, sem `userId`, e o
  /// índice composto acima não serve para isso — o primeiro campo dele é o
  /// usuário. Sem este, o expurgo de conformidade vira varredura da tabela.
  @@index([offeredAt])
}

/// Currículo enviado por quem ainda não tem conta, no envio da landing
/// (§2.132): "envie seu currículo e descubra as oportunidades que combinam
/// com você".
///
/// **A pessoa escolhe quanto tempo isto vive.** O padrão é apagar em 24 horas;
/// guardar para empresas a encontrarem exige marcação ativa (LGPD: o
/// consentimento não pode vir pré-marcado). `expiresAt` é a única regra de
/// retenção desta tabela, e vale nas duas pontas: a leitura recusa linha
/// vencida e a purga horária (`/api/cron/visitor-leads`) apaga.
///
/// O texto do currículo só é gravado quando a pessoa escolhe guardar. Quem
/// escolhe apagar é processado em memória, e aqui fica só o resultado.
model VisitorLead {
  /// Também é a credencial de leitura do resultado: 32 caracteres hex
  /// aleatórios gerados no servidor, e não `cuid()`, que é previsível.
  id        String  @id
  email     String
  /// Idioma da tela no envio — é o do resultado e o do e-mail.
  lang      String
  /// País da borda (ou da rota) no envio. Ordena o mercado das vagas quando
  /// o currículo não diz onde a pessoa está.
  country   String?
  /// processing | ready | failed
  status    String  @default("processing")
  /// Por que falhou, para a tela escolher a mensagem. Nunca texto de erro cru.
  failureCode String?
  /// `AtsCheckResult` do teste de legibilidade, em JSON.
  atsJson     String
  /// `ProfileSuggestion` lida do currículo, em JSON.
  profileJson String?
  /// Oportunidades em ordem de exibição: `[{ jobId, overall, recommendation }]`.
  matchesJson String?
  /// O currículo não trouxe cargo, área nem competências para comparar
  /// (`hasMatchableSignal`). Diferente de "nenhuma vaga": aqui não houve busca.
  profileInsufficient Boolean @default(false)
  /// Só preenchido quando `recruiterOptIn` é verdadeiro.
  resumeText  String?
  /// A pessoa escolheu guardar os dados para empresas a encontrarem.
  recruiterOptIn Boolean  @default(false)
  consentAt      DateTime @default(now())
  expiresAt      DateTime
  /// E-mail de resultado já enviado. Nulo quando não saiu.
  notifiedAt     DateTime?
  visitorId      String?
  /// Hash do IP (nunca o IP), para a cota — mesmo esquema de `ats-check/quota.ts`.
  ipKey          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([expiresAt])
  @@index([ipKey, createdAt])
  @@index([visitorId, createdAt])
}
